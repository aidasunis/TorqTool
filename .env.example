# Copia este archivo a ".env" (mismo nivel, junto a package.json) y pon tu endpoint real de Formspree.
# Lo consigues en https://formspree.io — crea un formulario nuevo y copia la URL que te dan
# (algo como https://formspree.io/f/xxxxabcd). Sin esto, el formulario de reserva solo guarda
# los datos en localStorage (para la demo/panel de métricas) pero no te llega nada por correo.

VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/tu_id_aqui
